<?xml version="1.0" encoding="UTF-8"?>
<!-- 实体、DTO、VO 和业务传输模型放在 entity，打成普通 jar；不依赖 common 或 server，父配置见 ../pom.xml。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xuan</groupId>
        <artifactId>DriftingLeavesV2</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>entity</artifactId>

    <dependencies>
        <!-- Lombok 在编译时生成模型代码，运行时不需要它。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 这里只声明 DTO 校验规则，真正执行校验由 server 的 Validation starter 负责。 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- 这里只要表、主键和字段注解，不把数据库 starter 带进模型模块。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <!-- 模型测试需要的依赖只在测试时使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
