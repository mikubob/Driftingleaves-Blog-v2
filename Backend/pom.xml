<?xml version="1.0" encoding="UTF-8"?>
<!-- 后端 Maven 父配置，统一管理版本和编译设置；子模块依赖见 common/pom.xml、entity/pom.xml 和 server/pom.xml。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 管理的依赖和构建插件版本，BOM 已经管的版本不再重复指定。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.xuan</groupId>
    <artifactId>DriftingLeavesV2</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- 这里只聚合 common、entity 和 server，业务依赖由 server 指向前两者，它们之间互不依赖。 -->
    <modules>
        <module>common</module>
        <module>entity</module>
        <module>server</module>
    </modules>

    <!-- 统一用 Java 21 和 UTF-8；Boot 没管理的版本放这里，同一家族的 MyBatis-Plus、Sa-Token、CommonMark 组件要保持同版。 -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <justauth.version>1.16.7</justauth.version>
        <fastjson-compatible.version>2.0.66</fastjson-compatible.version>
        <commonmark.version>0.31.0</commonmark.version>
        <jsoup.version>1.23.2</jsoup.version>
        <aliyun-oss.version>3.18.5</aliyun-oss.version>
        <ip2region.version>3.3.7</ip2region.version>
        <hutool.version>5.8.48</hutool.version>
    </properties>

    <!-- 这里只管理版本，不会自动给子模块加运行依赖。 -->
    <dependencyManagement>
        <dependencies>
            <!-- Hutool 按需引入核心、摘要和验证码模块，共用一个版本。 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-crypto</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-captcha</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- IPv4 和 IPv6 都在本地查询，用不依赖 Spring 或 Jackson 的官方客户端。 -->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>
            <!-- common 用到的 OSS 客户端版本在这里统一，不照搬旧项目版本。 -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <!-- 内部模块都用当前项目版本，避免误用老项目的包。 -->
            <dependency>
                <groupId>com.xuan</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xuan</groupId>
                <artifactId>entity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus 的注解、核心、Boot 4 接入和分页组件用同一个版本。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Sa-Token 核心、Boot 4 MVC 接入和 Redis 会话组件用同一个版本。 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-core</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- JustAuth 只处理第三方授权，本站会话仍交给 Sa-Token。 -->
            <dependency>
                <groupId>me.zhyd.oauth</groupId>
                <artifactId>JustAuth</artifactId>
                <version>${justauth.version}</version>
            </dependency>
            <!-- 用 Fastjson2 的 1.x 兼容包替换 JustAuth 的旧依赖；坐标必须保留 com.alibaba:fastjson，不能直接换成包名不同的 fastjson2 核心。 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson-compatible.version}</version>
            </dependency>
            <!-- Markdown 核心、表格、自动链接和任务列表扩展用同一个版本。 -->
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-autolink</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-task-list-items</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <!-- Markdown 渲染后还需要 jsoup 按白名单清理 HTML。 -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 子模块共用 Lombok 注解处理器，处理器和 provided 依赖都用 Boot BOM 的 lombok.version，避免两边版本不同。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
