<?xml version="1.0" encoding="UTF-8"?>
<!-- server 是唯一的 Boot 应用，组合 common 和 entity，提供接口、业务、数据库访问和鉴权；相关配置见 ../pom.xml、../common/pom.xml、../entity/pom.xml。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xuan</groupId>
        <artifactId>DriftingLeavesV2</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>server</artifactId>

    <dependencies>
        <!-- 复制公开响应对象并转义 Feed XML，不用于请求字段批量写入。 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>
        <!-- 公开查询通过 Spring Cache 注解接入 Redis。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- 用 Boot 4 的 AspectJ 代理执行限流和事务里的操作日志。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- 引入 common 公共工具，版本跟随父 POM。 -->
        <dependency>
            <groupId>com.xuan</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- 引入实体、DTO 和 VO，模型模块不能反过来依赖 server。 -->
        <dependency>
            <groupId>com.xuan</groupId>
            <artifactId>entity</artifactId>
        </dependency>
        <!-- 邮箱确认和订阅通知通过真实SMTP发送，连接信息来自外部spring.mail配置。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- 这里提供 MVC、REST、文件上传和默认的 Jackson 3 JSON 支持。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 在线统计使用原生 WebSocket，版本跟随现有 Boot BOM。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- 用 Jakarta Validation 实际执行 DTO 上声明的校验。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 接入 Boot 4 的 MyBatis-Plus，同时带入 JDBC、事务和 HikariCP。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 分页拦截器需要这套 SQL 解析支持，应用里还要注册分页插件。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- 运行时使用 MySQL JDBC 驱动，版本跟随 Boot BOM。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 提供 Redis 模板和 Lettuce 客户端，给 state、限流和缓存清理使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 接入本站 Sa-Token 会话和权限检查，Boot 4 MVC 包已经带了 Jackson 3 插件。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 用 Redis 存 Sa-Token 会话，不再额外引入 Jackson 2 会话插件。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>
        <!-- 平台客户端运行时需要 JustAuth，集成测试也会实际检查它的 state 和身份解析 API。 -->
        <dependency>
            <groupId>me.zhyd.oauth</groupId>
            <artifactId>JustAuth</artifactId>
        </dependency>
        <!-- 这里只用 BCrypt 等密码编码能力，本站鉴权仍由 Sa-Token 处理。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Lombok 只在编译时生成代码，打包时把它排除。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 应用测试的基础工具只在测试时使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 用 Boot 4 MVC 和 MockMvc 测试实际接口。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有 server 用 Boot 打包插件，沿用父配置的 repackage，通过实际启动类生成可执行 jar；Lombok 不放进运行包。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
