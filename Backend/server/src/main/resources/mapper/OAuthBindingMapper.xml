<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 平台 source 和 uuid 按数据库里的原值匹配，不存平台 Token。 -->
<mapper namespace="com.xuan.mapper.OAuthBindingMapper">
    <!-- 只按服务端验证过的 source 和 uuid 查唯一绑定，不能按昵称或邮箱合并账号；查到绑定还要检查用户启用，必要时用户锁后重查。 -->
    <select id="findIdentity" resultType="com.xuan.entity.SysUserOauth">
        SELECT * FROM sys_user_oauth WHERE source = #{source} AND uuid = #{uuid}
    </select>

    <!-- 用户全部绑定按 source 升序返回，不按平台开关过滤；能否登录、去掉 uuid 等内部字段由业务层处理。 -->
    <select id="findByUser" resultType="com.xuan.entity.SysUserOauth">
        SELECT * FROM sys_user_oauth WHERE user_id = #{userId} ORDER BY source
    </select>

    <!-- 删除同时限制用户和平台，不能只按 source 删；同一用户锁事务里要先查最近认证和最后登录方式。 -->
    <delete id="deleteBinding">
        DELETE FROM sys_user_oauth WHERE user_id = #{userId} AND source = #{source}
    </delete>
</mapper>
