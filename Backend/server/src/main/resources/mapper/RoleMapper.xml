<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuan.mapper.RoleMapper">

    <!-- 分页查询角色列表，按角色 ID 升序排列 -->
    <select id="rolePage" resultType="com.xuan.entity.SysRole">
        SELECT *
        FROM sys_role
        <where>
            <if test="query.keyword != null">
                AND (
                    INSTR(role_code, #{query.keyword}) &gt; 0
                    OR INSTR(role_name, #{query.keyword}) &gt; 0
                )
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY role_id ASC
    </select>

    <!-- 查询角色关联的全部权限 ID，按 ID 升序排列 -->
    <select id="permissionIds" resultType="long">
        SELECT permission_id
        FROM sys_role_permission
        WHERE role_id = #{roleId}
        ORDER BY permission_id
    </select>

    <!-- 查询角色关联的全部菜单 ID，按 ID 升序排列 -->
    <select id="menuIds" resultType="long">
        SELECT menu_id
        FROM sys_role_menu
        WHERE role_id = #{roleId}
        ORDER BY menu_id
    </select>

    <!-- 查询角色关联的全部用户 ID，按 ID 升序排列 -->
    <select id="userIds" resultType="long">
        SELECT user_id
        FROM sys_user_role
        WHERE role_id = #{roleId}
        ORDER BY user_id
    </select>

    <!-- 加行锁查询角色记录 -->
    <select id="lockById" resultType="com.xuan.entity.SysRole">
        SELECT *
        FROM sys_role
        WHERE role_id = #{roleId}
        FOR UPDATE
    </select>

    <!-- 完整更新角色资料与数据范围，显式写入可空说明字段 -->
    <update id="updateRole">
        UPDATE sys_role
        SET role_name = #{role.roleName},
            description = #{role.description},
            data_scope = #{role.dataScope}
        WHERE role_id = #{role.roleId}
    </update>

    <!-- 按 ID 升序加行锁查询启用状态的权限 ID -->
    <select id="lockEnabledPermissions" resultType="long">
        SELECT permission_id
        FROM sys_permission
        WHERE permission_id IN
        <foreach collection="ids" item="id" open="(" separator=", " close=")">
            #{id}
        </foreach>
          AND status = 1
        ORDER BY permission_id
        FOR UPDATE
    </select>

    <!-- 查询全部菜单节点（含禁用项） -->
    <select id="allMenus" resultType="com.xuan.entity.SysMenu">
        SELECT *
        FROM sys_menu
        ORDER BY menu_id
    </select>

    <!-- 清空指定角色的全部权限关联 -->
    <delete id="deletePermissions">
        DELETE FROM sys_role_permission
        WHERE role_id = #{roleId}
    </delete>

    <!-- 清空指定角色的全部菜单关联 -->
    <delete id="deleteMenus">
        DELETE FROM sys_role_menu
        WHERE role_id = #{roleId}
    </delete>

    <!-- 批量插入角色与权限的复合主键关联 -->
    <insert id="insertPermissions">
        INSERT INTO sys_role_permission (role_id, permission_id)
        VALUES
        <foreach collection="ids" item="id" separator=", ">
            (#{roleId}, #{id})
        </foreach>
    </insert>

    <!-- 批量插入角色与菜单的复合主键关联 -->
    <insert id="insertMenus">
        INSERT INTO sys_role_menu (role_id, menu_id)
        VALUES
        <foreach collection="ids" item="id" separator=", ">
            (#{roleId}, #{id})
        </foreach>
    </insert>

    <!-- 更新角色状态 -->
    <update id="updateStatus">
        UPDATE sys_role
        SET status = #{status}
        WHERE role_id = #{id}
    </update>

</mapper>
