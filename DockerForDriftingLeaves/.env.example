# 复制为 .env 后填写实际部署参数（.env 已被 .gitignore 忽略，不会上传到 GitHub）。

# 同一 Docker 网络中 Nginx 的实际 IP（逗号分隔多个可信代理），留空时后端忽略转发头。
TRUSTED_PROXIES=

# 数据库配置（连接时区与应用统一使用 UTC）。
DB_URL=jdbc:mysql://mysql:3306/your_database?useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=
DB_PASSWORD=

# Redis 配置。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=dl:v2:

# 站点公开基址与允许来源。
HOME_BASE_URL=https://example.com
BLOG_BASE_URL=https://blog.example.com
ADMIN_BASE_URL=https://admin.example.com
CV_BASE_URL=https://cv.example.com
PUBLIC_API_BASE_URL=https://blog.example.com/api/v1
FRONTEND_ORIGINS=https://example.com,https://blog.example.com,https://cv.example.com,https://admin.example.com
FILE_PUBLIC_ORIGINS=

# SMTP 邮件服务配置。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_ENABLED=true
MAIL_FROM=
MAIL_FROM_NAME=DriftingLeaves
MAIL_CONFIRM_URL=
MAIL_UNSUBSCRIBE_URL=

# 对象存储（阿里云 OSS）配置。
OSS_ENABLED=true
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 长期 AccessKey 留空；STS 使用配套令牌，并在到期前更新。
OSS_SECURITY_TOKEN=
OSS_KEY_PREFIX=

# 第三方 OAuth 登录配置。
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=
OAUTH_GITEE_ENABLED=false
OAUTH_GITEE_CLIENT_ID=
OAUTH_GITEE_CLIENT_SECRET=
OAUTH_GITEE_REDIRECT_URI=
OAUTH_QQ_ENABLED=false
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
OAUTH_QQ_REDIRECT_URI=
