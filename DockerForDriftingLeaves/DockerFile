FROM eclipse-temurin:21.0.7_6-jre-alpine

WORKDIR /app

# 创建非 root 运行用户，并提前准备上传目录与外部配置目录。
RUN addgroup -S app \
    && adduser -S -G app app \
    && mkdir -p /app/uploads /app/config \
    && chown -R app:app /app

COPY --chown=app:app backend/DriftingLeaves.jar app.jar

EXPOSE 5922

ENV TZ=Asia/Shanghai
ENV JAVA_OPTS="-Xms512m -Xmx1024m"

USER app

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
